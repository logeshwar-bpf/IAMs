# ==============================================================================
# IAMs Monorepo Environment Variables Example
# ==============================================================================

# Shared / GCP IAM
JWT_SECRET=your-secure-jwt-secret-key-here-minimum-32-chars
ADMIN_PASSWORD=your-secure-admin-password-here
MEMBER_PASSWORD=your-secure-member-password-here
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=
MEMBER_PASSWORD_HASH=
MEMBER_PASSWORD_SALT=
SA_PASSWORD_HASH=
SA_PASSWORD_SALT=

# Google Workspace IAM
API_KEY=your-secure-gws-api-key-here
MOCK_MODE=true
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_ADMIN_USER=

# Claude Plan Provisioning
ADMIN_USERNAME=admin
APP_URL=http://localhost:3001

# Jira Access Provisioning
ADMIN_EMAIL=admin@jira.internal
